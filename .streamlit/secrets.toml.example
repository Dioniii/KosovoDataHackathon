# Copy this file to .streamlit/secrets.toml (gitignored — never commit real keys)
# and fill in your own Ollama Cloud API key. Get one at https://ollama.com.
#
# For the Streamlit Community Cloud deploy, paste the same two lines into the
# app's Settings -> Secrets box instead of committing this file.

[ollama]
api_key = "your-ollama-cloud-api-key"
model = "gpt-oss:120b-cloud"
